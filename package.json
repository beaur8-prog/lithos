{
  "name": "lithos-notes",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Local-first Markdown workspace with connected notes and canvas",
  "author": "Lithos",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "LITHOS_DEV=1 electron .",
    "build": "tsc -b && vite build && vite build --config vite.share.config.ts",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && node scripts/package-mac.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/collab": "^6.1.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.2",
    "@uiw/react-codemirror": "^4.23.10",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "local.lithos.notes",
    "productName": "Lithos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-share/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": "dir",
      "icon": "assets/icon.icns"
    }
  },
  "overrides": {
    "katex": "$katex"
  }
}
